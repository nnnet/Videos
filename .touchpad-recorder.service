[Unit]
Description=Touchpad button-event recorder (diagnostic for stuck-button bug)
After=graphical.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/touchpad-recorder.sh
Restart=on-failure
RestartSec=5
# safety: minimal privileges, write only to log file
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
